[
 {
  "id": "nested-event-location",
  "category": "nested",
  "description": "An object argument with nested fields.",
  "tools": [
   "create_event"
  ],
  "messages": [
   {
    "role": "user",
    "content": "Create an event 'Design review' at 2026-11-18T14:00 in Berlin, room 4."
   }
  ],
  "expect": {
   "calls": [
    {
     "name": "create_event",
     "arguments": {
      "title": {
       "contains": "design review"
      },
      "start": {
       "contains": "2026-11-18T14:00"
      },
      "location": {
       "object": {
        "city": {
         "contains": "berlin"
        },
        "room": {
         "contains": "4"
        }
       }
      }
     }
    }
   ]
  }
 },
 {
