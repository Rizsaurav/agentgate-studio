 {
  "id": "nested-issue-assignee",
  "category": "nested",
  "description": "An object argument with a required field.",
  "tools": [
   "create_issue"
  ],
  "messages": [
   {
    "role": "user",
    "content": "Open an issue titled 'Crash on launch' assigned to octocat."
   }
  ],
  "expect": {
   "calls": [
    {
     "name": "create_issue",
     "arguments": {
      "title": {
       "contains": "crash on launch"
      },
      "assignee": {
       "object": {
        "login": {
         "equals": "octocat"
        }
       }
      }
     }
    }
   ]
  }
 },
 {
