  ],
  "messages": [
   {
    "role": "user",
    "content": "Search for 'Token' case-sensitively, only in .swift files."
   }
  ],
  "expect": {
   "calls": [
    {
     "name": "search_files",
     "arguments": {
      "query": {
       "contains": "Token"
      },
      "options": {
