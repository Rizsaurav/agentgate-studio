# Copy to .env (git-ignored). Used by `docker compose`; variables are read by name, upper case.

# Optional keys. Never commit real values. A container has no OS keychain, so keys go here.
# Turns on the assistant (https://openrouter.ai/keys):
OPENROUTER_API_KEY=
# Cloud models in sessions (any one is enough; OpenRouter above also works for sessions):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# Key for the custom OpenAI-compatible endpoint set up on the Models page, if it needs one:
# AGENTGATE_CUSTOM_API_KEY=

# Optional: app port on your computer (default 3000).
# PORT=3000

# Optional: where Ollama is. Default: Ollama running on your computer.
# For the bundled container (`docker compose --profile ollama up`): http://ollama:11434
# AGENTGATE_OLLAMA_URL=http://host.docker.internal:11434
